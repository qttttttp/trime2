+     */
+    public static HttpTask putFile(String url, String path, HashMap<String, String> header, LuaValue callback) {
+        Http.HttpTask task = new HttpTask(url, "PUT", null, null, header, callback);
+        task.execute(new File(path));
+        return task;
+    }
