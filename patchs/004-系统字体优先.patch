+    private Typeface getNativeChain() {
+        if (mNativeChainChecked) return mNativeChain;
+        mNativeChainChecked = true;
+        if (android.os.Build.VERSION.SDK_INT < android.os.Build.VERSION_CODES.Q) return null;
+        LuaValue n = get("font");
