+    /** 是否为"系统字体"占位符 */
+    private static boolean isSystemFontToken(String s) {
+        if (TextUtils.isEmpty(s)) return false;
+        s = s.trim().toLowerCase();
+        for (String t : SYSTEM_FONT_TOKENS)
+            if (t.equals(s)) return true;
+        return false;
