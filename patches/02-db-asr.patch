+ */
+
+package com.osfans.trime;
+
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * db ASR 协议配置：所有经逆向工程获得的协议细节均在此配置，
+ * 代码中不保留任何db协议的具体参数值。
+ * 用户在主题 asr_config 中自行填写，公开版 patch 不包含任何协议实现细节。
+ */
+public class DbProtocolConfig {
+
+    // ===== 连接配置（必填） =====
+    public final String wsUrl;
+
+    // ===== 凭据（可选，空则自动注册/获取） =====
+    public final String deviceId;
+    public final String token;
+    public final String userAgent;
+
+    // ===== 协议标识 =====
+    public final int aid;
+    public final String appPackage;
+
+    // ===== 服务端点 =====
+    public final String registerUrl;
+    public final String settingsUrl;
+
+    // ===== WebSocket 请求头 =====
+    public final String wsProtoVersion;
+    public final String wsKeepalive;
+
+    // ===== 设备注册查询参数（Map 灵活配置） =====
+    public final Map<String, String> registerQueryParams;
+
+    // ===== 设备注册请求体 JSON 模板（占位符: {openudid} {clientudid} {cdid} {aid} {app_package}） =====
+    public final String registerBodyTemplate;
+
+    // ===== Token 获取 =====
+    public final String tokenBody;
+
+    // ===== 会话配置 JSON 模板（占位符: {channels} {sample_rate} {app_name} {device_id}） =====
+    public final String sessionConfigTemplate;
+
+    // ===== 消息类型 =====
+    public final String serviceName;
+    public final String methodStartTask;
+    public final String methodStartSession;
+    public final String methodFinishSession;
+    public final String methodTaskRequest;
+
+    // ===== 帧状态枚举 =====
+    public final int frameStateUnspecified;
+    public final int frameStateFirst;
+    public final int frameStateMiddle;
+    public final int frameStateLast;
+
+    // ===== 音频编码 =====
+    public final int opusBitrate;
+    public final int opusFrameEstimateBytes;
+
+    // ===== 音频参数 =====
+    public final int sampleRate;
+    public final int channels;
+    public final int frameDurationMs;
+    public final String appName;
+
+    /**
+     * 构造方法：从 Lua 配置表构建协议配置
+     *
+     * @param wsUrl       WebSocket 地址（必填）
+     * @param deviceId    设备 ID（空则自动注册获取）
+     * @param token       ASR Token（空则自动获取）
+     * @param userAgent   User-Agent
+     * @param aid         应用 ID
+     * @param appPackage  应用包名
+     * @param registerUrl 设备注册 URL
+     * @param settingsUrl Token 获取 URL
+     * @param wsProtoVersion   WebSocket proto-version 头值
+     * @param wsKeepalive      WebSocket x-custom-keepalive 头值
+     * @param registerQueryParams 设备注册查询参数 Map
+     * @param registerBodyTemplate  设备注册请求体 JSON 模板
+     * @param tokenBody       Token 获取请求体
+     * @param sessionConfigTemplate  会话配置 JSON 模板
+     * @param serviceName     服务名
+     * @param methodStartTask  StartTask 方法名
+     * @param methodStartSession StartSession 方法名
+     * @param methodFinishSession FinishSession 方法名
+     * @param methodTaskRequest TaskRequest 方法名
+     * @param frameStateUnspecified 帧状态：未指定
+     * @param frameStateFirst        帧状态：首帧
+     * @param frameStateMiddle       帧状态：中间帧
+     * @param frameStateLast         帧状态：末帧
+     * @param opusBitrate     Opus 编码比特率
+     * @param opusFrameEstimateBytes Opus 单帧估算字节数
+     * @param sampleRate     采样率
+     * @param channels       声道数
+     * @param frameDurationMs 帧时长（毫秒）
+     * @param appName        作用应用包名
+     */
+    public DbProtocolConfig(
+            String wsUrl,
+            String deviceId,
+            String token,
+            String userAgent,
+            int aid,
+            String appPackage,
+            String registerUrl,
+            String settingsUrl,
+            String wsProtoVersion,
+            String wsKeepalive,
+            Map<String, String> registerQueryParams,
+            String registerBodyTemplate,
+            String tokenBody,
+            String sessionConfigTemplate,
+            String serviceName,
+            String methodStartTask,
+            String methodStartSession,
+            String methodFinishSession,
+            String methodTaskRequest,
+            int frameStateUnspecified,
+            int frameStateFirst,
+            int frameStateMiddle,
+            int frameStateLast,
+            int opusBitrate,
+            int opusFrameEstimateBytes,
+            int sampleRate,
+            int channels,
+            int frameDurationMs,
+            String appName) {
+
+        this.wsUrl = wsUrl;
+        this.deviceId = deviceId;
+        this.token = token;
+        this.userAgent = userAgent;
+        this.aid = aid;
+        this.appPackage = appPackage;
+        this.registerUrl = registerUrl;
+        this.settingsUrl = settingsUrl;
+        this.wsProtoVersion = wsProtoVersion;
+        this.wsKeepalive = wsKeepalive;
+        this.registerQueryParams = registerQueryParams != null
+                ? registerQueryParams : new HashMap<>();
+        this.registerBodyTemplate = registerBodyTemplate;
+        this.tokenBody = tokenBody;
+        this.sessionConfigTemplate = sessionConfigTemplate;
+        this.serviceName = serviceName;
+        this.methodStartTask = methodStartTask;
+        this.methodStartSession = methodStartSession;
+        this.methodFinishSession = methodFinishSession;
+        this.methodTaskRequest = methodTaskRequest;
+        this.frameStateUnspecified = frameStateUnspecified;
+        this.frameStateFirst = frameStateFirst;
+        this.frameStateMiddle = frameStateMiddle;
+        this.frameStateLast = frameStateLast;
+        this.opusBitrate = opusBitrate;
+        this.opusFrameEstimateBytes = opusFrameEstimateBytes;
+        this.sampleRate = sampleRate;
+        this.channels = channels;
+        this.frameDurationMs = frameDurationMs;
+        this.appName = appName;
+    }
+}
