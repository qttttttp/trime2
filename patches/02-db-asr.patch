+package com.osfans.trime;
+
+import android.media.MediaCodec;
+import android.media.MediaFormat;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.security.MessageDigest;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.TimeUnit;
+
+import okhttp3.Headers;
+import okhttp3.HttpUrl;
+import okhttp3.MediaType;
+import okhttp3.OkHttpClient;
+import okhttp3.Request;
+import okhttp3.RequestBody;
+import okhttp3.Response;
+import okhttp3.WebSocket;
+import okhttp3.WebSocketListener;
+import okio.ByteString;
+
+/**
+ * db ASR 客户端，继承 AiClient，通过 WebSocket + Protobuf 协议进行语音识别。
+ * 协议来源：zhuiyue132/db-asr
+ * 源码仅作支持，所有 API 配置通过主题 asr_config 外置。
+ */
+public class DbASRClient extends AiClient {
+
+    // ===== 协议配置（全部外置于 DbProtocolConfig，代码不保留任何db协议参数值） =====
+    private final DbProtocolConfig cfg;
+
+    // ===== 配置字段（由 DbProtocolConfig 派生，便于内部引用） =====
+    private final String wsUrl;
+    private final String deviceId;
+    private final String token;
+    private final String userAgent;
+    private final int sampleRate;
+    private final int channels;
+    private final int frameDurationMs;
+    private final String appName;
+
+    // ===== 内部状态 =====
+    private final OkHttpClient wsHttpClient;
+    private final Handler mainHandler = new Handler(Looper.getMainLooper());
+
+    /**
+     * 构造方法：传入db ASR 协议配置（全部协议细节由配置承载）
+     *
+     * @param cfg DbProtocolConfig，包含连接、凭据、端点、请求头、
+     *            注册/会话模板、消息类型、帧状态、音频编码等全部协议配置
+     */
+    public DbASRClient(DbProtocolConfig cfg) {
+        super(cfg.wsUrl, cfg.token); // 复用父类构造（baseUrl/apiKey 占位）
+        this.cfg = cfg;
+        this.wsUrl = cfg.wsUrl;
+        this.deviceId = cfg.deviceId;
+        this.token = cfg.token;
+        this.userAgent = cfg.userAgent;
+        this.sampleRate = cfg.sampleRate;
+        this.channels = cfg.channels;
+        this.frameDurationMs = cfg.frameDurationMs;
+        this.appName = cfg.appName;
+
+        this.wsHttpClient = new OkHttpClient.Builder()
+                .connectTimeout(120, TimeUnit.SECONDS)
+                .readTimeout(120, TimeUnit.SECONDS)
+                .pingInterval(30, TimeUnit.SECONDS)
+                .build();
+    }
+
+    // =========================================================================
+    //  重写 recognizeAudio：走 WebSocket + Protobuf 协议
+    // =========================================================================
+
+    @Override
+    public AiSession recognizeAudio(byte[] audioBytes, AiCallback callback) {
+        // 在后台线程执行完整的 WebSocket 识别流程
+        Thread worker = new Thread(() -> {
+            try {
+                // 1. 确保凭据可用
+                String[] creds = ensureCredentials();
+                String finalDeviceId = creds[0];
+                String finalToken = creds[1];
+
+                // 2. 构建完整 WebSocket URL
+                String fullWsUrl = wsUrl + "?aid=" + cfg.aid
+                        + "&device_id=" + finalDeviceId;
+
+                // 3. 构建 WebSocket 请求头
+                Headers wsHeaders = new Headers.Builder()
+                        .add("User-Agent", userAgent)
+                        .add("proto-version", cfg.wsProtoVersion)
+                        .add("x-custom-keepalive", cfg.wsKeepalive)
+                        .build();
+
+                // 4. WAV → PCM → Opus
+                byte[] pcmData = wavToPcm(audioBytes);
+                byte[] opusFrames = encodeOpus(pcmData);
+
+                // 5. 构建会话配置 JSON
+                String sessionConfigJson = buildSessionConfig(finalDeviceId);
+
+                // 6. 生成请求 ID
+                String requestId = UUID.randomUUID().toString();
+
+                // 7. 连接 WebSocket
+                Request wsRequest = new Request.Builder()
+                        .url(fullWsUrl)
+                        .headers(wsHeaders)
+                        .build();
+
+                wsHttpClient.newWebSocket(wsRequest, new DbWebSocketListener(
+                        callback, opusFrames, requestId, finalToken, sessionConfigJson));
+
+            } catch (Exception e) {
+                postFailure(callback, e);
+            }
+        }, "DbASR");
+        worker.setDaemon(true);
+        worker.start();
+
+        // Speech.java 不使用返回值，返回 null 即可
+        return null;
+    }
+
+    // =========================================================================
+    //  凭据管理：设备注册 / Token 获取
+    // =========================================================================
+
+    /**
+     * 确保凭据可用：deviceId 或 token 为空时自动注册/获取
+     */
+    private String[] ensureCredentials() throws Exception {
+        String finalDeviceId = deviceId;
+        String finalToken = token;
+
+        if (finalDeviceId == null || finalDeviceId.isEmpty()) {
+            finalDeviceId = registerDevice();
+        }
+        if (finalToken == null || finalToken.isEmpty()) {
+            finalToken = getAsrToken(finalDeviceId);
+        }
+        return new String[]{finalDeviceId, finalToken};
+    }
+
+    /**
+     * 注册设备，获取 device_id
+     */
+    private String registerDevice() throws Exception {
+        String cdid = UUID.randomUUID().toString();
+        String openudid = randomHex(8);
+        String clientudid = UUID.randomUUID().toString();
+
+        String body = buildRegisterBody(cdid, openudid, clientudid);
+
+        HttpUrl baseUrl = HttpUrl.parse(cfg.registerUrl);
+        HttpUrl.Builder urlBuilder = baseUrl.newBuilder();
+        // 从配置 Map 遍历添加查询参数，值支持 {aid} / {app_package} 占位符
+        for (Map.Entry<String, String> entry : cfg.registerQueryParams.entrySet()) {
+            String key = entry.getKey();
+            // cdid 与 _rticket 由代码动态生成，跳过配置中的同名项避免重复
+            if ("cdid".equals(key) || "_rticket".equals(key)) {
+                continue;
+            }
+            String value = entry.getValue()
+                    .replace("{aid}", String.valueOf(cfg.aid))
+                    .replace("{app_package}", cfg.appPackage);
+            urlBuilder.addQueryParameter(key, value);
+        }
+        // 动态添加时间戳与设备标识
+        urlBuilder.addQueryParameter("_rticket", String.valueOf(System.currentTimeMillis()))
+                .addQueryParameter("cdid", cdid);
+
+        Request request = new Request.Builder()
+                .url(urlBuilder.build())
+                .header("User-Agent", userAgent)
+                .post(RequestBody.create(body, MediaType.get("application/json; charset=utf-8")))
+                .build();
+
+        try (Response response = wsHttpClient.newCall(request).execute()) {
+            String respBody = response.body() != null ? response.body().string() : "";
+            java.util.regex.Matcher m = java.util.regex.Pattern
+                    .compile("\"device_id\"\\s*:\\s*(\\d+)")
+                    .matcher(respBody);
+            if (m.find()) {
+                return m.group(1);
+            }
+            throw new IOException("Device registration failed: " + respBody);
+        }
+    }
+
+    /**
+     * 获取 ASR Token
+     */
+    private String getAsrToken(String deviceId) throws Exception {
+        String cdid = UUID.randomUUID().toString();
+
+        HttpUrl baseUrl = HttpUrl.parse(cfg.settingsUrl);
+        HttpUrl.Builder urlBuilder = baseUrl.newBuilder();
+        // 复用注册查询参数配置，值支持 {aid} / {app_package} 占位符
+        for (Map.Entry<String, String> entry : cfg.registerQueryParams.entrySet()) {
+            String key = entry.getKey();
+            if ("cdid".equals(key) || "_rticket".equals(key) || "device_id".equals(key)) {
+                continue;
+            }
+            String value = entry.getValue()
+                    .replace("{aid}", String.valueOf(cfg.aid))
+                    .replace("{app_package}", cfg.appPackage);
+            urlBuilder.addQueryParameter(key, value);
+        }
+        urlBuilder.addQueryParameter("_rticket", String.valueOf(System.currentTimeMillis()))
+                .addQueryParameter("cdid", cdid)
+                .addQueryParameter("device_id", deviceId);
+
+        String bodyStr = cfg.tokenBody;
+        String xSsStub = md5Hex(bodyStr).toUpperCase();
+
+        Request request = new Request.Builder()
+                .url(urlBuilder.build())
+                .header("User-Agent", userAgent)
+                .header("x-ss-stub", xSsStub)
+                .post(RequestBody.create(bodyStr, MediaType.get("application/x-www-form-urlencoded")))
+                .build();
+
+        try (Response response = wsHttpClient.newCall(request).execute()) {
+            String respBody = response.body() != null ? response.body().string() : "";
+            java.util.regex.Matcher m = java.util.regex.Pattern
+                    .compile("\"app_key\"\\s*:\\s*\"([^\"]+)\"")
+                    .matcher(respBody);
+            if (m.find()) {
+                return m.group(1);
+            }
+            throw new IOException("Token fetch failed: " + respBody);
+        }
+    }
+
+    /**
+     * 构建设备注册请求体 JSON：渲染配置模板，占位符替换为实际值
+     * 模板占位符：{openudid} {clientudid} {cdid} {aid} {app_package}
+     */
+    private String buildRegisterBody(String cdid, String openudid, String clientudid) {
+        return renderTemplate(cfg.registerBodyTemplate, cdid, openudid, clientudid);
+    }
+
+    /**
+     * 渲染模板：替换协议占位符
+     */
+    private String renderTemplate(String template, String cdid,
+                                  String openudid, String clientudid) {
+        if (template == null || template.isEmpty()) {
+            return "";
+        }
+        return template
+                .replace("{openudid}", openudid)
+                .replace("{clientudid}", clientudid)
+                .replace("{cdid}", cdid)
+                .replace("{aid}", String.valueOf(cfg.aid))
+                .replace("{app_package}", cfg.appPackage);
+    }
+    /**
+     * 渲染会话配置模板：替换协议占位符
+     * 模板占位符：{channels} {sample_rate} {app_name} {device_id}
+     */
+    private String renderSessionTemplate(String template, String deviceId) {
+        if (template == null || template.isEmpty()) {
+            return "";
+        }
+        return template
+                .replace("{channels}", String.valueOf(channels))
+                .replace("{sample_rate}", String.valueOf(sampleRate))
+                .replace("{app_name}", appName)
+                .replace("{device_id}", deviceId);
+    }
+
+    /**
+     * 构建会话配置 JSON：渲染配置模板
+     */
+    private String buildSessionConfig(String deviceId) {
+        return renderSessionTemplate(cfg.sessionConfigTemplate, deviceId);
+    }
+
+    // =========================================================================
+    //  音频处理：WAV → PCM → Opus
+    // =========================================================================
+
+    /**
+     * WAV 字节数组转为 PCM（16-bit 小端序）
+     */
+    private byte[] wavToPcm(byte[] wavData) {
+        if (wavData == null || wavData.length <= 44) {
+            return new byte[0];
+        }
+        // 检查是否为 WAV 格式（RIFF....WAVE）
+        boolean isWav = wavData.length >= 12
+                && wavData[0] == 'R' && wavData[1] == 'I'
+                && wavData[2] == 'F' && wavData[3] == 'F'
+                && wavData[8] == 'W' && wavData[9] == 'A'
+                && wavData[10] == 'V' && wavData[11] == 'E';
+
+        if (isWav) {
+            // 遍历 WAV 头，找到 "data" 块
+            int dataOffset = 44;
+            for (int i = 12; i < wavData.length - 8; i++) {
+                if (wavData[i] == 'd' && wavData[i + 1] == 'a'
+                        && wavData[i + 2] == 't' && wavData[i + 3] == 'a') {
+                    // data 块长度在 i+4 ~ i+7（小端序 int32）
+                    int dataLen = (wavData[i + 7] & 0xFF) << 24
+                            | (wavData[i + 6] & 0xFF) << 16
+                            | (wavData[i + 5] & 0xFF) << 8
+                            | (wavData[i + 4] & 0xFF);
+                    dataOffset = i + 8;
+                    int pcmLen = Math.min(dataLen, wavData.length - dataOffset);
+                    byte[] pcm = new byte[pcmLen];
+                    System.arraycopy(wavData, dataOffset, pcm, 0, pcmLen);
+                    return pcm;
+                }
+            }
+            // 未找到 data 块，默认跳过 44 字节头
+            byte[] pcm = new byte[wavData.length - dataOffset];
+            System.arraycopy(wavData, dataOffset, pcm, 0, pcm.length);
+            return pcm;
+        }
+        // 已经是 PCM
+        return wavData;
+    }
+
+    /**
+     * PCM → Opus 编码，返回拼接的 Opus 帧数据
+     * 使用 Android MediaCodec 编码器
+     */
+    private byte[] encodeOpus(byte[] pcmData) {
+        if (pcmData == null || pcmData.length == 0) {
+            return new byte[0];
+        }
+
+        int samplesPerFrame = sampleRate * frameDurationMs / 1000;
+        int bytesPerFrame = samplesPerFrame * 2; // 16-bit
+
+        ByteArrayOutputStream opusOut = new ByteArrayOutputStream();
+        MediaCodec encoder = null;
+
+        try {
+            encoder = MediaCodec.createEncoderByType("audio/opus");
+            MediaFormat format = MediaFormat.createAudioFormat("audio/opus",
+                    sampleRate, channels);
+            format.setInteger(MediaFormat.KEY_BIT_RATE, cfg.opusBitrate);
+            format.setInteger(MediaFormat.KEY_AAC_PROFILE, 0);
+            encoder.configure(format, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE);
+            encoder.start();
+
+            int frameIndex = 0;
+            int offset = 0;
+
+            while (offset < pcmData.length) {
+                int chunkLen = Math.min(bytesPerFrame, pcmData.length - offset);
+                byte[] chunk = new byte[chunkLen];
+                System.arraycopy(pcmData, offset, chunk, 0, chunkLen);
+                // 不足一帧则补零
+                if (chunkLen < bytesPerFrame) {
+                    byte[] padded = new byte[bytesPerFrame];
+                    System.arraycopy(chunk, 0, padded, 0, chunkLen);
+                    chunk = padded;
+                }
+
+                // 送入编码器
+                int inIdx = encoder.dequeueInputBuffer(10000);
+                if (inIdx >= 0) {
+                    android.media.MediaCodec.BufferInfo inInfo = new android.media.MediaCodec.BufferInfo();
+                    // 使用 getInputBuffer（API 21+）
+                    java.nio.ByteBuffer inputBuf;
+                    if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.M) {
+                        inputBuf = encoder.getInputBuffer(inIdx);
+                    } else {
+                        inputBuf = encoder.getInputBuffers()[inIdx];
+                    }
+                    inputBuf.clear();
+                    inputBuf.put(chunk);
+                    long pts = frameIndex * frameDurationMs;
+                    encoder.queueInputBuffer(inIdx, 0, chunk.length, pts, 0);
+                    frameIndex++;
+                }
+
+                // 取出编码后的 Opus 数据
+                while (true) {
+                    android.media.MediaCodec.BufferInfo outInfo = new android.media.MediaCodec.BufferInfo();
+                    int outIdx = encoder.dequeueOutputBuffer(outInfo, 10000);
+                    if (outIdx >= 0) {
+                        java.nio.ByteBuffer outputBuf;
+                        if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.M) {
+                            outputBuf = encoder.getOutputBuffer(outIdx);
+                        } else {
+                            outputBuf = encoder.getOutputBuffers()[outIdx];
+                        }
+                        if (outputBuf != null && outInfo.size > 0) {
+                            byte[] opusFrame = new byte[outInfo.size];
+                            outputBuf.position(0);
+                            outputBuf.get(opusFrame);
+                            opusOut.write(opusFrame, 0, opusFrame.length);
+                        }
+                        encoder.releaseOutputBuffer(outIdx, false);
+                    } else {
+                        break;
+                    }
+                }
+
+                offset += bytesPerFrame;
+            }
+
+            // 通知编码器结束
+            int inIdx = encoder.dequeueInputBuffer(10000);
+            if (inIdx >= 0) {
+                if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.M) {
+                    encoder.getInputBuffer(inIdx).clear();
+                } else {
+                    encoder.getInputBuffers()[inIdx].clear();
+                }
+                encoder.queueInputBuffer(inIdx, 0, 0, 0,
+                        MediaCodec.BUFFER_FLAG_END_OF_STREAM);
+            }
+
+            // 取出剩余数据
+            while (true) {
+                android.media.MediaCodec.BufferInfo outInfo = new android.media.MediaCodec.BufferInfo();
+                int outIdx = encoder.dequeueOutputBuffer(outInfo, 10000);
+                if (outIdx >= 0) {
+                    java.nio.ByteBuffer outputBuf;
+                    if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.M) {
+                        outputBuf = encoder.getOutputBuffer(outIdx);
+                    } else {
+                        outputBuf = encoder.getOutputBuffers()[outIdx];
+                    }
+                    if (outputBuf != null && outInfo.size > 0) {
+                        byte[] opusFrame = new byte[outInfo.size];
+                        outputBuf.position(0);
+                        outputBuf.get(opusFrame);
+                        opusOut.write(opusFrame, 0, opusFrame.length);
+                    }
+                    encoder.releaseOutputBuffer(outIdx, false);
+                } else {
+                    break;
+                }
+            }
+
+        } catch (Exception e) {
+            Log.e("DbASR", "Opus encode failed: " + e.getMessage(), e);
+        } finally {
+            if (encoder != null) {
+                try {
+                    encoder.stop();
+                    encoder.release();
+                } catch (Exception e) {
+                    Log.e("DbASR", "Encoder release failed: " + e.getMessage());
+                }
+            }
+        }
+
+        return opusOut.toByteArray();
+    }
+
+    // =========================================================================
+    //  WebSocket 监听器
+    // =========================================================================
+
+    private class DbWebSocketListener extends WebSocketListener {
+        private final AiCallback callback;
+        private final byte[] opusFrames;
+        private final String requestId;
+        private final String token;
+        private final String sessionConfigJson;
+        private final StringBuilder finalText = new StringBuilder();
+        private WebSocket webSocket;
+        private int frameIndex = 0;
+        private int framesPerBatch;
+
+        DbWebSocketListener(AiCallback callback, byte[] opusFrames,
+                                String requestId, String token, String sessionConfigJson) {
+            this.callback = callback;
+            this.opusFrames = opusFrames;
+            this.requestId = requestId;
+            this.token = token;
+            this.sessionConfigJson = sessionConfigJson;
+            // 每帧 Opus 约 60 字节（20ms @ 24kbps），按此估算帧数
+            this.framesPerBatch = opusFrames.length > 0 ? 1 : 0;
+        }
+
+        @Override
+        public void onOpen(WebSocket ws, Response response) {
+            this.webSocket = ws;
+
+            // 1. Send StartTask
+            ws.send(ByteString.of(buildProtobufRequest(
+                    token, cfg.serviceName, cfg.methodStartTask, null, null,
+                    requestId, cfg.frameStateUnspecified)));
+
+            // 2. Send StartSession
+            ws.send(ByteString.of(buildProtobufRequest(
+                    token, cfg.serviceName, cfg.methodStartSession, sessionConfigJson, null,
+                    requestId, cfg.frameStateUnspecified)));
+
+            // 3. Send audio frames
+            sendAudioFrames(ws);
+
+            // 4. Send FinishSession
+            ws.send(ByteString.of(buildProtobufRequest(
+                    token, cfg.serviceName, cfg.methodFinishSession, null, null,
+                    requestId, cfg.frameStateUnspecified)));
+        }
+
+        private void sendAudioFrames(WebSocket ws) {
+            if (opusFrames == null || opusFrames.length == 0) {
+                // 发送一个空 LAST 帧
+                String payload = "{\"extra\":{},\"timestamp_ms\":"
+                        + System.currentTimeMillis() + "}";
+                ws.send(ByteString.of(buildProtobufRequest(
+                        token, cfg.serviceName, cfg.methodTaskRequest, payload,
+                        new byte[0], requestId, cfg.frameStateLast)));
+                return;
+            }
+
+            // 将 Opus 数据按帧分割发送
+            // 每帧 Opus 编码后大小不确定，按配置的估算字节数分割帧
+            // 实际 Opus 帧更小，但服务器按帧状态识别
+            int estimatedFrameSize = Math.max(1, cfg.opusFrameEstimateBytes);
+            int totalFrames = Math.max(1, opusFrames.length / estimatedFrameSize);
+            long timestamp = System.currentTimeMillis();
+
+            for (int i = 0; i < totalFrames; i++) {
+                int start = i * estimatedFrameSize;
+                int end = Math.min(start + estimatedFrameSize, opusFrames.length);
+                byte[] frame = new byte[end - start];
+                System.arraycopy(opusFrames, start, frame, 0, end - start);
+
+                int frameState;
+                if (i == 0) {
+                    frameState = cfg.frameStateFirst;
+                } else if (i == totalFrames - 1) {
+                    frameState = cfg.frameStateLast;
+                } else {
+                    frameState = cfg.frameStateMiddle;
+                }
+
+                String payload = "{\"extra\":{},\"timestamp_ms\":"
+                        + (timestamp + i * frameDurationMs) + "}";
+
+                ws.send(ByteString.of(buildProtobufRequest(
+                        token, cfg.serviceName, cfg.methodTaskRequest, payload,
+                        frame, requestId, frameState)));
+            }
+
+            // 如果最后一段不足，补一个 LAST 帧
+            if (opusFrames.length % estimatedFrameSize != 0) {
+                int start = totalFrames * estimatedFrameSize;
+                byte[] remaining = new byte[opusFrames.length - start];
+                System.arraycopy(opusFrames, start, remaining, 0, remaining.length);
+                String payload = "{\"extra\":{},\"timestamp_ms\":"
+                        + (timestamp + totalFrames * frameDurationMs) + "}";
+                ws.send(ByteString.of(buildProtobufRequest(
+                        token, cfg.serviceName, cfg.methodTaskRequest, payload,
+                        remaining, requestId, cfg.frameStateLast)));
+            }
+        }
+
+        @Override
+        public void onMessage(WebSocket ws, String text) {
+            // db协议使用二进制消息，忽略文本消息
+        }
+
+        @Override
+        public void onMessage(WebSocket ws, ByteString bytes) {
+            try {
+                byte[] data = bytes.toByteArray();
+                String resultJson = parseProtobufResponse(data);
+
+                if (resultJson == null || resultJson.isEmpty()) {
+                    return;
+                }
+
+                // 检查 message_type
+                com.google.gson.JsonObject jsonObj =
+                        com.google.gson.JsonParser.parseString(resultJson).getAsJsonObject();
+
+                if (jsonObj.has("message_type")) {
+                    String msgType = jsonObj.get("message_type").getAsString();
+                    if ("SessionFinished".equals(msgType)) {
+                        String text = finalText.toString();
+                        ws.close(1000, "Done");
+                        postSuccess(callback, text);
+                        return;
+                    }
+                    if ("TaskFailed".equals(msgType) || "SessionFailed".equals(msgType)) {
+                        String errMsg = jsonObj.has("status_message")
+                                ? jsonObj.get("status_message").getAsString() : "ASR error";
+                        ws.close(1000, "Error");
+                        postFailure(callback, new Exception(errMsg));
+                        return;
+                    }
+                }
+
+                // 解析识别结果
+                if (jsonObj.has("results")) {
+                    com.google.gson.JsonArray results = jsonObj.getAsJsonArray("results");
+                    for (com.google.gson.JsonElement el : results) {
+                        com.google.gson.JsonObject r = el.getAsJsonObject();
+                        if (r.has("text")) {
+                            String text = r.get("text").getAsString();
+                            boolean isInterim = r.has("is_interim")
+                                    && !r.get("is_interim").isJsonNull()
+                                    && r.get("is_interim").getAsBoolean();
+                            boolean vadFinished = r.has("is_vad_finished")
+                                    && !r.get("is_vad_finished").isJsonNull()
+                                    && r.get("is_vad_finished").getAsBoolean();
+                            boolean nonstream = r.has("extra")
+                                    && r.getAsJsonObject("extra").has("nonstream_result")
+                                    && r.getAsJsonObject("extra").get("nonstream_result").getAsBoolean();
+
+                            if (nonstream || (!isInterim && vadFinished)) {
+                                finalText.setLength(0);
+                                finalText.append(text);
+                            } else {
+                                finalText.setLength(0);
+                                finalText.append(text);
+                            }
+                        }
+                    }
+                }
+            } catch (Exception e) {
+                Log.w("DbASR", "Parse response failed: " + e.getMessage());
+            }
+        }
+
+        @Override
+        public void onClosing(WebSocket ws, int code, String reason) {
+            ws.close(1000, null);
+        }
+
+        @Override
+        public void onClosed(WebSocket ws, int code, String reason) {
+            String text = finalText.toString();
+            postSuccess(callback, text);
+        }
+
+        @Override
+        public void onFailure(WebSocket ws, Throwable t, Response response) {
+            postFailure(callback, new Exception("Db ASR WebSocket error: "
+                    + (t != null ? t.getMessage() : "unknown"), t));
+        }
+    }
+
+    // =========================================================================
+    //  Protobuf 编码（手写二进制，不引入 protobuf 依赖）
+    // =========================================================================
+
+    /**
+     * 构建 Protobuf AsrRequest 消息
+     */
+    private byte[] buildProtobufRequest(
+            String token, String serviceName, String methodName,
+            String payload, byte[] audioData, String requestId, int frameState) {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+
+        // 字段 2: token (string, tag=0x12)
+        if (token != null && !token.isEmpty()) {
+            writeTag(out, 2, 2);
+            writeString(out, token);
+        }
+        // 字段 3: service_name (string, tag=0x1A)
+        if (serviceName != null && !serviceName.isEmpty()) {
+            writeTag(out, 3, 2);
+            writeString(out, serviceName);
+        }
+        // 字段 5: method_name (string, tag=0x2A)
+        if (methodName != null && !methodName.isEmpty()) {
+            writeTag(out, 5, 2);
+            writeString(out, methodName);
+        }
+        // 字段 6: payload (string, tag=0x32)
+        if (payload != null && !payload.isEmpty()) {
+            writeTag(out, 6, 2);
+            writeString(out, payload);
+        }
+        // 字段 7: audio_data (bytes, tag=0x3A)
+        if (audioData != null && audioData.length > 0) {
+            writeTag(out, 7, 2);
+            writeBytes(out, audioData);
+        }
+        // 字段 8: request_id (string, tag=0x42)
+        if (requestId != null && !requestId.isEmpty()) {
+            writeTag(out, 8, 2);
+            writeString(out, requestId);
+        }
+        // 字段 9: frame_state (enum, tag=0x48, varint)
+        if (frameState != cfg.frameStateUnspecified) {
+            writeTag(out, 9, 0);
+            writeVarint(out, frameState);
+        }
+
+        return out.toByteArray();
+    }
+
+    /**
+     * 解析 Protobuf AsrResponse 消息
+     */
+    private static String parseProtobufResponse(byte[] data) {
+        if (data == null || data.length == 0) {
+            return null;
+        }
+        int pos = 0;
+        String messageType = "";
+        String resultJson = "";
+        String statusMessage = "";
+
+        while (pos < data.length) {
+            int[] tagResult = readVarint(data, pos);
+            int tag = tagResult[0];
+            pos = tagResult[1];
+            int fieldNum = tag >> 3;
+            int wireType = tag & 0x07;
+
+            switch (fieldNum) {
+                case 4: // message_type (string)
+                    String[] v4 = readString(data, pos, wireType);
+                    messageType = v4[0];
+                    pos = Integer.parseInt(v4[1]);
+                    break;
+                case 6: // status_message (string)
+                    String[] v6 = readString(data, pos, wireType);
+                    statusMessage = v6[0];
+                    pos = Integer.parseInt(v6[1]);
+                    break;
+                case 7: // result_json (string)
+                    String[] v7 = readString(data, pos, wireType);
+                    resultJson = v7[0];
+                    pos = Integer.parseInt(v7[1]);
+                    break;
+                default:
+                    pos = skipField(data, pos, wireType);
+                    break;
+            }
+        }
+
+        // 优先返回 result_json（识别结果）
+        if (resultJson != null && !resultJson.isEmpty()) {
+            return resultJson;
+        }
+        // 否则返回 message_type
+        if (messageType != null && !messageType.isEmpty()) {
+            return messageType;
+        }
+        return statusMessage;
+    }
+
+    // ===== Protobuf 编码辅助方法 =====
+
+    private static void writeTag(ByteArrayOutputStream out, int fieldNum, int wireType) {
+        writeVarint(out, (fieldNum << 3) | wireType);
+    }
+
+    private static void writeVarint(ByteArrayOutputStream out, int value) {
+        while ((value & 0xFFFFFF80) != 0) {
+            out.write((value & 0x7F) | 0x80);
+            value >>>= 7;
+        }
+        out.write(value & 0x7F);
+    }
+
+    private static void writeString(ByteArrayOutputStream out, String s) {
+        byte[] bytes = s.getBytes(java.nio.charset.StandardCharsets.UTF_8);
+        writeVarint(out, bytes.length);
+        out.write(bytes, 0, bytes.length);
+    }
+
+    private static void writeBytes(ByteArrayOutputStream out, byte[] data) {
+        writeVarint(out, data.length);
+        out.write(data, 0, data.length);
+    }
+
+    private static int[] readVarint(byte[] data, int pos) {
+        int value = 0;
+        int shift = 0;
+        int startPos = pos;
+        while (pos < data.length) {
+            byte b = data[pos];
+            value |= (b & 0x7F) << shift;
+            pos++;
+            if ((b & 0x80) == 0) {
+                break;
+            }
+            shift += 7;
+        }
+        return new int[]{value, pos};
+    }
+
+    private static String[] readString(byte[] data, int pos, int wireType) {
+        if (wireType == 2) {
+            int[] lenResult = readVarint(data, pos);
+            int len = lenResult[0];
+            int dataStart = lenResult[1];
+            if (dataStart + len <= data.length) {
+                String s = new String(data, dataStart, len,
+                        java.nio.charset.StandardCharsets.UTF_8);
+                return new String[]{s, String.valueOf(dataStart + len)};
+            }
+        }
+        return new String[]{"", String.valueOf(pos)};
+    }
+
+    private static int skipField(byte[] data, int pos, int wireType) {
+        switch (wireType) {
+            case 0: // varint
+                return readVarint(data, pos)[1];
+            case 1: // 64-bit
+                return pos + 8;
+            case 2: // length-delimited
+                int[] len = readVarint(data, pos);
+                return len[1] + len[0];
+            case 5: // 32-bit
+                return pos + 4;
+            default:
+                return data.length;
+        }
+    }
+
+    // =========================================================================
+    //  辅助方法
+    // =========================================================================
+
+    private static String randomHex(int len) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < len; i++) {
+            sb.append(String.format("%02x", (int) (Math.random() * 256)));
+        }
+        return sb.toString();
+    }
+
+    private static String md5Hex(String s) throws Exception {
+        MessageDigest md = MessageDigest.getInstance("MD5");
+        byte[] digest = md.digest(s.getBytes());
+        StringBuilder sb = new StringBuilder();
+        for (byte b : digest) {
+            sb.append(String.format("%02x", b));
+        }
+        return sb.toString();
+    }
+
+    private void postSuccess(final AiCallback callback, final String result) {
+        if (callback == null) return;
+        mainHandler.post(() -> callback.onSuccess(result));
+    }
+
+    private void postFailure(final AiCallback callback, final Exception e) {
+        if (callback == null) return;
+        mainHandler.post(() -> callback.onFailure(e));
+    }
+}
