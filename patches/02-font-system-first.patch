+    /** 是否为"系统字体"占位符 */
+    private static boolean isSystemFontToken(String s) {
+        if (TextUtils.isEmpty(s)) return false;
+        s = s.trim().toLowerCase();
+        for (String t : SYSTEM_FONT_TOKENS)
+            if (t.equals(s)) return true;
+        return false;
+    }
+
+    /**
+     * 原生逐字形回退链:font 表按顺序逐项入链,system 占位符出现在第一个位置时，
+     * 直接使用 Framework Typeface.SANS_SERIF 完整系统回退链作为base；
+     * 后续配置字体作为附加自定义fallback。失败返回 null。
+     */
+    private Typeface getNativeChain() {
+        if (mNativeChainChecked) return mNativeChain;
+        mNativeChainChecked = true;
+        if (android.os.Build.VERSION.SDK_INT < android.os.Build.VERSION_CODES.Q) return null;
+        LuaValue n = get("font");
+        if (n.isnil()) {
+            n = ThemeManager.getStyle().getStyle("keyboard").get("font");
+        }
+        if (!n.istable() || n.length() < 1) return null;
+
+        ArrayList<FontFamily> families = new ArrayList<>();
+        boolean firstIsSystemToken = false;
+
+        for (int i = 1; i <= n.length(); i++) {
+            String name = n.get(i).optjstring("").trim();
+            if (isSystemFontToken(name)) {
+                if (i == 1) firstIsSystemToken = true;
+                continue;
+            }
+            if (TextUtils.isEmpty(name)) continue;
+            try {
+                File f = new File(Config.getFontPath(name));
+                if (f.exists()) {
+                    families.add(new FontFamily.Builder(new Font.Builder(f).build()).build());
+                }
+            } catch (Exception e) {
+                e.printStackTrace();
+            }
+        }
+
+        try {
+            Typeface.CustomFallbackBuilder b;
+            if (firstIsSystemToken) {
+                // 直接复用Framework完整SANS_SERIF，继承系统原生Minikin回退链
+                b = new Typeface.CustomFallbackBuilder(Typeface.SANS_SERIF);
+            } else {
+                if (families.isEmpty()) return null;
+                b = new Typeface.CustomFallbackBuilder(families.get(0));
+                for (int i = 1; i < families.size(); i++) {
+                    b.addCustomFallback(families.get(i));
+                }
+                mNativeChain = b.build();
+                return mNativeChain;
+            }
+            // 追加yaml配置的附加后备字体
+            for (FontFamily fm : families) {
+                b.addCustomFallback(fm);
+            }
+            // 双重兜底：全部自定义family耗尽再次触发系统sans‑serif回退
+            b.setSystemFallback("sans‑serif");
+            mNativeChain = b.build();
+        } catch (Exception e) {
+            e.printStackTrace();
+            return null;
+        }
+        return mNativeChain;
+    }
