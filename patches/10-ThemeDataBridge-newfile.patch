@@ -0,0 +1,394 @@
+/*
+ * ThemeDataBridge —— 主题工作室（tools Lua）数据桥接
+ *
+ * 目的：让运行在【同一进程、不同 Lua 虚拟机】里的“主题工作室”脚本，
+ * 直接拿到输入法已经加载好的当前主题全部数据（样式表 + 配色 + 当前键盘布局），
+ * 而不必在工具自己的沙箱里重新执行主题 Lua（那会因为缺少真机环境而处处崩溃/补洞）。
+ *
+ * 原理：Java 静态字段跨同进程的所有 LuaJ Globals 共享。本类只做一件事：
+ *   读取 ThemeManager.mGlobals / mColor 及当前键盘 Globals，
+ *   把其中的纯数据（数字/字符串/布尔/table）递归序列化成 Lua 字面量字符串返回。
+ * 全程【不调用任何 native 引擎方法、不执行键盘脚本的真机逻辑】，
+ * 因此绝对安全，pcall 之外也不会有 native 崩溃风险。
+ *
+ * 兜底：若输入法尚未加载主题（静态字段为空），用与输入法同源的纯加载链补齐：
+ *   主题/配色 → ThemeManager.setTheme()（TrimeService 初始化用的同一方法）
+ *   键盘      → 独立 Globals + 键盘目录 finder 纯加载当前键盘脚本
+ *
+ * 用法（工具端 Lua）：
+ *   local ok, data = pcall(function()
+ *     return loadstring(luajava.bindClass("com.osfans.trime.theme.ThemeDataBridge").snapshot())()
+ *   end)
+ *   -- data.style    : 完整样式表（配色 mColor 展开 __index 继承链）
+ *   -- data.keyboard : 当前键盘 { rows=..., key_width=..., key_height=..., name=... }
+ *   -- data.meta     : { theme=..., style=..., keyboard=..., source=... }
+ */
+package com.osfans.trime.theme;
+
+import android.text.TextUtils;
+import android.text.Spanned;
+import android.text.style.ImageSpan;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.TextView;
+
+import com.osfans.trime.Config;
+import com.osfans.trime.InputView;
+import com.osfans.trime.TrimeService;
+
+import org.luaj.Globals;
+import org.luaj.LuaTable;
+import org.luaj.LuaValue;
+import org.luaj.lib.ResourceFinder;
+import org.luaj.lib.jse.JsePlatform;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.InputStream;
+import java.util.IdentityHashMap;
+
+public final class ThemeDataBridge {
+    private ThemeDataBridge() {}
+
+    private static final int MAX_DEPTH = 24;        // 递归深度上限
+    private static final int MAX_NODES = 20000;     // 节点数上限，防止超大表卡死
+    private static final int MAX_STR = 4096;        // 单个字符串最大长度
+
+    private static final class Counter {
+        int nodes = 0;
+    }
+
+    /**
+     * 生成主题数据快照（Lua 字面量字符串）。任何异常都返回一个合法的空表字符串，
+     * 保证工具端 loadstring 永远成功、绝不因本方法崩溃。
+     */
+    public static String snapshot() {
+        // 确保数据已加载（输入法没启动过时用同源纯加载补齐）
+        ensureLoaded();
+
+        StringBuilder out = new StringBuilder();
+        out.append("local d={}\n");
+        try {
+            LuaTable color = safeColor();
+            LuaTable globals = safeGlobals();
+            Globals kbd = safeKeyboardGlobals();
+
+            // ---- 1. 样式表：主题根（继承层）+ 配色覆盖，展开 __index 合并 ----
+            out.append("d.style=");
+            if (color != null) {
+                Counter c = new Counter();
+                StringBuilder merged = new StringBuilder();
+                merged.append("{");
+                IdentityHashMap<LuaValue, Boolean> seen = new IdentityHashMap<LuaValue, Boolean>();
+                writeEntries(merged, globals, seen, 1, c);   // 继承层先写
+                writeEntries(merged, color, seen, 1, c);     // 配色覆盖
+                merged.append("}");
+                out.append(merged);
+            } else if (globals != null) {
+                Counter c = new Counter();
+                writeValue(out, globals, new IdentityHashMap<LuaValue, Boolean>(), 0, c);
+            } else {
+                out.append("{}");
+            }
+            out.append("\n");
+
+            // ---- 2. 当前键盘数据 ----
+            out.append("d.keyboard=");
+            if (kbd != null) {
+                Counter c = new Counter();
+                writeValue(out, kbd, new IdentityHashMap<LuaValue, Boolean>(), 0, c);
+            } else {
+                out.append("{}");
+            }
+            out.append("\n");
+
+            // ---- 3. 元信息 ----
+            out.append("d.meta={\n");
+            out.append("theme=").append(luaString(safeStr(Config.getTheme()))).append(",\n");
+            out.append("style=").append(luaString(safeStr(Config.getStyle()))).append(",\n");
+            out.append("keyboard=").append(luaString(currentKeyboardName(kbd))).append(",\n");
+            out.append("source=").append(luaString(sourceOf(color, globals, kbd))).append("\n");
+            out.append("}\n");
+        } catch (Throwable t) {
+            out.setLength(0);
+            out.append("local d={style={},keyboard={},meta={}}");
+        }
+        out.append("\nreturn d");
+        return out.toString();
+    }
+
+    private static String sourceOf(LuaTable color, LuaTable globals, Globals kbd) {
+        StringBuilder s = new StringBuilder();
+        s.append(color != null ? "color" : (globals != null ? "globals" : "none"));
+        s.append("+");
+        s.append(kbd != null ? "keyboard" : "no-keyboard");
+        return s.toString();
+    }
+
+    private static String currentKeyboardName(Globals kbd) {
+        try {
+            if (kbd != null) {
+                LuaValue n = kbd.get("name");
+                if (n != null && n.isstring() && !TextUtils.isEmpty(n.tojstring())) return n.tojstring();
+            }
+        } catch (Throwable ignored) {}
+        return safeStr(Config.getKeyboard());
+    }
+
+    // ============ 数据获取 + 同源兜底 ============
+
+    /** 若输入法尚未加载主题，用同源方法补齐 ThemeManager 的静态字段 */
+    private static void ensureLoaded() {
+        try {
+            Globals g = ThemeManager.getGlobals();
+            if (g == null || g.isnil() || ThemeManager.getColor() == null) {
+                String theme = Config.getTheme();
+                if (!TextUtils.isEmpty(theme)) {
+                    // 这正是 TrimeService.onCreate 初始化主题时调用的方法，纯加载、不碰 native 引擎
+                    ThemeManager.setTheme(theme);
+                }
+            }
+        } catch (Throwable ignored) {}
+    }
+
+    private static LuaTable safeColor() {
+        try {
+            LuaTable c = ThemeManager.getColor();
+            return (c != null && !c.isnil()) ? c : null;
+        } catch (Throwable t) { return null; }
+    }
+
+    private static LuaTable safeGlobals() {
+        try {
+            Globals g = ThemeManager.getGlobals();
+            return (g != null && !g.isnil()) ? g : null;
+        } catch (Throwable t) { return null; }
+    }
+
+    /**
+     * 当前键盘 Globals：
+     *   ① InputView 的静态快照（输入法已加载键盘时必然有值）
+     *   ② 独立 Globals + 键盘目录 finder 纯加载当前键盘脚本
+     */
+    private static Globals safeKeyboardGlobals() {
+        try {
+            Globals g = InputView.getCurrentKeyboardGlobals();
+            if (g != null) return g;
+        } catch (Throwable ignored) {}
+        return loadKeyboardNow();
+    }
+
+    /** 兜底：用独立 Globals + 键盘目录 finder 纯加载当前键盘脚本（纯数据，安全） */
+    private static Globals loadKeyboardNow() {
+        try {
+            String name = Config.getKeyboard();
+            if (TextUtils.isEmpty(name)) name = "qwerty36";
+            final String kbdDir = Config.getKeyboardDir();
+            if (TextUtils.isEmpty(kbdDir)) return null;
+
+            // 用标准 Globals（含全部标准库），再把真机对象替换成安全桩
+            Globals g = JsePlatform.standardGlobals();
+            g.finder = new ResourceFinder() {
+                @Override
+                public InputStream findResource(String filename) {
+                    try {
+                        File f = new File(kbdDir, filename);
+                        return f.exists() ? new FileInputStream(f) : null;
+                    } catch (Throwable t) { return null; }
+                }
+                @Override
+                public String findFile(String filename) {
+                    if (filename != null && filename.startsWith("/")) return filename;
+                    return new File(kbdDir, filename == null ? "" : filename).getAbsolutePath();
+                }
+            };
+            // 注入常见真机全局为 no-op 桩，保证键盘脚本顶部的 import/gesture 等
+            // 初始化调用不中断，让后面的 rows/allk 纯数据定义能执行到。
+            final LuaValue noop = new org.luaj.LuaFunction() {
+                @Override public LuaValue call() { return LuaValue.NIL; }
+                @Override public LuaValue call(LuaValue a) { return LuaValue.NIL; }
+                @Override public LuaValue call(LuaValue a, LuaValue b) { return LuaValue.NIL; }
+                @Override public LuaValue call(LuaValue a, LuaValue b, LuaValue c) { return LuaValue.NIL; }
+            };
+            String[] stubs = {"import", "service", "this", "gesture", "luajava",
+                    "PreferenceManager", "LuaApplication", "activity", "context"};
+            for (String s : stubs) g.set(LuaValue.valueOf(s), noop);
+            LuaValue func = g.loadfilex(name + ".lua");
+            if (func != null && func.isfunction()) func.call();
+            return g;
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    private static String safeStr(String s) { return s == null ? "" : s; }
+
+    // ============ 序列化 ============
+
+    private static void writeValue(StringBuilder out, LuaValue v,
+                                   IdentityHashMap<LuaValue, Boolean> seen,
+                                   int depth, Counter c) {
+        c.nodes++;
+        if (c.nodes > MAX_NODES || depth > MAX_DEPTH) { out.append("nil"); return; }
+        try {
+            if (v.isnil()) { out.append("nil"); return; }
+            if (v.isboolean()) { out.append(v.toboolean() ? "true" : "false"); return; }
+            if (v.isnumber()) { out.append(numLit(v.todouble())); return; }
+            if (v.isstring()) { out.append(luaString(clipStr(v.tojstring()))); return; }
+            if (v.istable()) {
+                LuaTable t = v.checktable();
+                if (seen.containsKey(t)) { out.append("{}"); return; }  // 循环引用截断
+                seen.put(t, Boolean.TRUE);
+                out.append("{");
+                writeEntries(out, t, seen, depth + 1, c);
+                out.append("}");
+                seen.remove(t);
+                return;
+            }
+            // function / userdata / thread 等不可序列化
+            out.append("nil");
+        } catch (Throwable t) {
+            out.append("nil");
+        }
+    }
+
+    private static void writeEntries(StringBuilder out, LuaTable tbl,
+                                     IdentityHashMap<LuaValue, Boolean> seen,
+                                     int depth, Counter c) {
+        if (tbl == null || depth > MAX_DEPTH || c.nodes > MAX_NODES) return;
+        LuaValue[] keys = null;
+        try { keys = tbl.keys(); } catch (Throwable t) { return; }
+        if (keys == null) return;
+        for (LuaValue k : keys) {
+            if (k == null || c.nodes > MAX_NODES) continue;
+            LuaValue v;
+            try { v = tbl.get(k); } catch (Throwable t) { continue; }
+            if (v == null || v.isnil() || v.isfunction() || v.isuserdata() || v.isthread()) continue;
+            String keyLit = null;
+            if (k.isstring()) keyLit = "[" + luaString(k.tojstring()) + "]";
+            else if (k.isnumber()) keyLit = "[" + numLit(k.todouble()) + "]";
+            if (keyLit == null) continue;
+            out.append(keyLit).append("=");
+            writeValue(out, v, seen, depth + 1, c);
+            out.append(",");
+        }
+    }
+
+    private static String clipStr(String s) {
+        if (s == null) return "";
+        return s.length() > MAX_STR ? s.substring(0, MAX_STR) : s;
+    }
+
+    private static String numLit(double d) {
+        if (Double.isNaN(d) || Double.isInfinite(d)) return "0";
+        if (d == Math.floor(d) && d >= -9007199254740992L && d <= 9007199254740992L)
+            return Long.toString((long) d);
+        return Double.toString(d);
+    }
+
+    private static String luaString(String s) {
+        if (s == null) return "\"\"";
+        StringBuilder b = new StringBuilder(s.length() + 8);
+        b.append('"');
+        for (int i = 0; i < s.length(); i++) {
+            char ch = s.charAt(i);
+            switch (ch) {
+                case '\\': b.append("\\\\"); break;
+                case '"':  b.append("\\\""); break;
+                case '\n': b.append("\\n"); break;
+                case '\r': b.append("\\r"); break;
+                case '\t': b.append("\\t"); break;
+                case '\b': b.append("\\b"); break;
+                case '\f': b.append("\\f"); break;
+                default:
+                    if (ch < 0x20) b.append(String.format("\\%03d", (int) ch));
+                    else b.append(ch);
+            }
+        }
+        b.append('"');
+        return b.toString();
+    }
+
+    // =====================================================================
+    // 主题工作室数据桥接：读真机【整个 RootInputView】当前显示的所有文本
+    // ---------------------------------------------------------------------
+    // 真机与工具是同一进程、不同 Lua 虚拟机；工具进程里 Service 实例不是
+    // 正在渲染键盘的那个对象，工具侧反射读 View 拿不到。这里在 Java 编译期
+    // 直接持有 TrimeService.onCreate 保存的 RootInputView 静态引用，在 Java 内部
+    // 遍历【整棵树】（键盘 + 工具栏 + 候选栏），把每个 TextView 的最终显示文本与
+    // 是否含 ImageSpan 序列化返回。工具只读字符串，无 native 引擎调用。
+    // =====================================================================
+    public static String dumpRootTexts() {
+        StringBuilder out = new StringBuilder();
+        try {
+            View root = TrimeService.getCurrentRootView();
+            if (root == null) {
+                out.append("ERR: RootInputView 为空（输入法视图尚未就绪？）");
+                return out.toString();
+            }
+            String cls = root.getClass().getName();
+            out.append("ROOT: ").append(cls).append('\n');
+            walkView(root, out, 0, new int[]{0}, "");
+            out.append("---- DONE ----");
+        } catch (Throwable t) {
+            out.append("ERR: ").append(t);
+        }
+        return out.toString();
+    }
+
+    /** 兼容别名：早期工具端调用此方法，实际返回整个 root 的文本 */
+    public static String dumpKeyboardTexts() {
+        return dumpRootTexts();
+    }
+
+    private static void walkView(View v, StringBuilder out, int depth, int[] count, String region) {
+        if (v == null || depth > 22 || count[0] >= 600) return;
+        try {
+            String cname = v.getClass().getName();
+            String shortName = cname.substring(cname.lastIndexOf('.') + 1);
+            // 根据类名推断当前所在区域，标注在每行前，方便对照
+            String here = region;
+            String lc = cname.toLowerCase();
+            if (lc.contains("toolbar")) here = "TOOLBAR";
+            else if (lc.contains("candidate")) here = "CANDIDATE";
+            else if (lc.contains("keyboard") || lc.contains("keyview")) here = "KEYBOARD";
+            else if (lc.contains("composition") || lc.contains("preedit")) here = "COMPOSITION";
+            if (v instanceof TextView) {
+                CharSequence cs = ((TextView) v).getText();
+                boolean img = false;
+                if (cs instanceof Spanned) {
+                    Spanned sp = (Spanned) cs;
+                    img = sp.getSpans(0, sp.length(), ImageSpan.class).length > 0;
+                }
+                String txt = cs == null ? "" : cs.toString().replace("\n", "\\n");
+                out.append('[').append(here.isEmpty() ? "-" : here).append("] ")
+                   .append(pad(depth)).append(shortName)
+                   .append('@').append(v.getLeft()).append(',').append(v.getTop())
+                   .append(' ').append(v.getWidth()).append('x').append(v.getHeight())
+                   .append(img ? " [IMG]" : " [TXT]")
+                   .append(" = [").append(txt).append("]\n");
+                count[0]++;
+            }
+            try {
+                if (v instanceof ViewGroup) {
+                    ViewGroup g = (ViewGroup) v;
+                    int n = g.getChildCount();
+                    for (int i = 0; i < n; i++) {
+                        walkView(g.getChildAt(i), out, depth + 1, count, here);
+                    }
+                }
+            } catch (Throwable ignore) {
+                // 子 View 遍历失败不影响整体
+            }
+        } catch (Throwable ignore) {
+            // 单个 View 读取失败不影响整体遍历
+        }
+    }
+
+    private static String pad(int depth) {
+        StringBuilder s = new StringBuilder();
+        int n = Math.min(depth, 10);
+        for (int i = 0; i < n; i++) s.append("  ");
+        return s.toString();
+    }
+}
